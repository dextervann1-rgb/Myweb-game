{
  "name": "omega-monorepo",
  "private": true,
  "packageManager": "npm@10.8.2",
  "scripts": {
    "build": "NODE_ENV=production npm --prefix packages/frontend run build",
    "dev": "npm --prefix packages/frontend run dev",
    "lint": "npm --prefix packages/frontend run lint",
    "test": "node --test test/*.test.mjs",
    "build:aab": "cd android && ./gradlew bundleRelease",
    "build:aab:debug": "cd android && ./gradlew bundleDebug"
  },
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=18.0.0"
  }
}